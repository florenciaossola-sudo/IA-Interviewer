{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "legacy/**/*.d.ts",
    "admin/**/*.ts",
    "admin/**/*.tsx",
    "reviewer/**/*.ts",
    "reviewer/**/*.tsx",
    "vite.admin.config.ts",
    "vite.reviewer.config.ts",
    "vitest.config.ts"
  ]
}
