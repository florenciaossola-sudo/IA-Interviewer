{
  "name": "@ai-interviewer/portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.admin.config.ts --host 127.0.0.1 --port 4173",
    "dev:reviewer": "vite --config vite.reviewer.config.ts --host 127.0.0.1 --port 4175",
    "build": "npm run build:admin && npm run build:reviewer",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:reviewer": "vite build --config vite.reviewer.config.ts",
    "preview": "vite preview --config vite.admin.config.ts --host 127.0.0.1 --port 4173",
    "preview:reviewer": "vite preview --config vite.reviewer.config.ts --host 127.0.0.1 --port 4175",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "node e2e/reviewer-smoke.e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
